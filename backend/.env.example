# Copie este archivo como .env y complete los valores. .env NUNCA se sube al repositorio (S-01).

NODE_ENV=development
PORT=3000

# Conexión por el pooler de Supabase en modo sesión (Render no soporta IPv6).
# Usuario: viajaya_api.<ref-del-proyecto>  — NO use el usuario postgres (ignora RLS).
DATABASE_URL=postgresql://viajaya_api.<ref>:<contraseña>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Opcional pero recomendado en producción: contenido PEM del certificado de Supabase
# (Dashboard > Database > Settings > SSL Configuration > Download certificate).
DATABASE_CA=

# Mínimo 32 caracteres aleatorios. Genere uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Vigencia del token del administrador en segundos (8 h = una jornada laboral).
JWT_EXPIRA_SEGUNDOS=28800

# Orígenes que pueden llamar a la API (separados por coma).
CORS_ORIGENES=http://localhost:5173

BCRYPT_COSTO=12
LOG_NIVEL=info

# Correos al turista (confirmación, cambio de fecha, cancelación y aprobación).
# consola = no envía nada, solo lo registra en el log (recomendado en desarrollo).
# brevo | resend = envía por la API HTTPS del proveedor (Render gratuito bloquea SMTP).
CORREO_PROVEEDOR=consola
CORREO_API_KEY=
# Remitente verificado en el proveedor (en Brevo: Senders, domains & dedicated IPs > Senders).
CORREO_REMITENTE=
CORREO_REMITENTE_NOMBRE=ViajaYa
# Dirección pública del sitio, para el enlace "Ver mi reserva" del correo.
SITIO_URL=http://localhost:5173

# Solo para el script `npm run crear-admin`. Bórrelos del .env después de usarlo.
ADMIN_NOMBRE=
ADMIN_CORREO=
ADMIN_PASSWORD=
